---
import LinkIcon from "@/assets/icons/akar-icons--link-out.svg";
const { name, href, title, description, icon: Icon, accent } = Astro.props;
---

<a
  href={href}
  title={title}
  target="_blank"
  rel="noreferrer"
  class={`group relative flex flex-row items-center justify-start gap-4 rounded bg-neutral-100 hover:bg-neutral-200 hover:ring-neutral-300 hover:ring-offset-neutral-100 dark:bg-neutral-900 p-4 transition-all ease-in-out dark:hover:bg-neutral-800 hover:ring-2 dark:hover:ring-neutral-700 dark:hover:ring-offset-neutral-900`}
>
  <LinkIcon
    class="absolute top-2 right-2 size-4 opacity-10 transition-opacity ease-in-out group-hover:opacity-35"
  />
  <Icon class={`size-12 ${accent} rounded p-2`} />
  <div class="flex flex-col justify-center">
    <span class="text-lg font-semibold">{name}</span>
    <span class="text-sm text-neutral-600 dark:text-neutral-400"
      >{description}</span
    >
  </div>
</a>
